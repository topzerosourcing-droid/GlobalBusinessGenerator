rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Permanent Super Admin verification:
    // 1. Authenticated email matches one of the two permanent super admin accounts (case-insensitive)
    // 2. OR verified super_admin document exists
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'topogabolekwe@gmail.com' ||
          request.auth.token.email.lower() == 'gabolekwetopo@gmail.com'
        )) ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
      );
    }

    // Super Admin collection - internal directory
    match /super_admins/{adminId} {
      allow read, write: if isSuperAdmin();
    }

    // User profile documents:
    // - Super Admin can read, create, update, delete ANY user profile
    // - Owner can read their own profile
    // - Owner cannot grant themselves SUPER_ADMIN role or alter account status
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isSuperAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'USER' || request.resource.data.role == null) &&
        (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin != true)
      );
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isSuperAdmin', 'status', 'isActive'])
      );
      allow delete: if isSuperAdmin();
    }

    // Business plans collection:
    // Super Admin has full unrestricted read/write/delete access across all users' business plans
    match /business_plans/{planId} {
      allow read: if (resource != null && resource.data.isPublic == true)
                  || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin()));
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Products collection (Monetization packages catalog)
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin(); // Super Admin can configure catalog
    }

    // Orders collection:
    // Super Admin has full visibility and write access for PayPal administration & order reconciliation
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSuperAdmin() || (
        isAuthenticated() 
        && request.resource.data.userId == request.auth.uid 
        && request.resource.data.status in ['pending', 'payment_pending', 'draft']
      );
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Payments collection:
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // Entitlements collection:
    // Super Admin can view, grant, revoke, and manage entitlements for any user or plan
    match /entitlements/{entitlementId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSuperAdmin() || (
        isAuthenticated() 
        && request.resource.data.userId == request.auth.uid 
        && (
          request.resource.data.packageId == 'free' ||
          (request.resource.data.packageId in ['pro', 'investor'] && request.resource.data.verificationToken != null)
        )
      );
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Subscriptions collection (Future recurring tiers)
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // Referrals collection
    match /referrals/{referralCode} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // Analytics telemetry
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // System configuration & settings
    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
