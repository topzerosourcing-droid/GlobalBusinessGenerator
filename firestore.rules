rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to verify Super Admin email address (supports exact and lowercase matching)
    function isSuperAdminEmail(email) {
      return email != null && (
        email == 'gabolekwetopo@gmail.com' ||
        email == 'topogabolekwe@gmail.com' ||
        email.lower() == 'gabolekwetopo@gmail.com' ||
        email.lower() == 'topogabolekwe@gmail.com'
      );
    }

    // Permanent Super Admin verification:
    // 1. Authenticated email matches gabolekwetopo@gmail.com or topogabolekwe@gmail.com
    // 2. OR verified super_admin document exists by UID
    // 3. OR user profile document has role == 'SUPER_ADMIN' or matches super admin email
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && isSuperAdminEmail(request.auth.token.email)) ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          isSuperAdminEmail(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN'
        ))
      );
    }

    // =========================================================================
    // MASTER SUPER ADMIN ACCESS GATE
    // =========================================================================
    // Grants complete, unrestricted read, write, create, update, and delete rights
    // across ALL collections and documents for gabolekwetopo@gmail.com & topogabolekwe@gmail.com
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Super Admin collection - internal directory
    match /super_admins/{adminId} {
      allow read, write: if isSuperAdmin() || (isAuthenticated() && isSuperAdminEmail(request.auth.token.email));
    }

    // User profile documents:
    // - Super Admin has full unrestricted read/write/delete rights
    // - Owner can read their own profile
    // - Super admin emails can always create/update their profile with SUPER_ADMIN role & enterprise tier
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isSuperAdmin() || 
        (isAuthenticated() && isSuperAdminEmail(request.auth.token.email)) ||
        (request.resource.data.email != null && isSuperAdminEmail(request.resource.data.email)) || (
          isOwner(userId) &&
          (!('role' in request.resource.data) || request.resource.data.role == 'USER' || request.resource.data.role == null) &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin != true)
        );
      allow update: if isSuperAdmin() || 
        (isAuthenticated() && isSuperAdminEmail(request.auth.token.email)) ||
        (resource.data.email != null && isSuperAdminEmail(resource.data.email)) || (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isSuperAdmin', 'status', 'isActive'])
        );
      allow delete: if isSuperAdmin();
    }

    // Business plans collection:
    // Super Admin has full unrestricted read/write/delete access across all users' business plans
    match /business_plans/{planId} {
      allow read: if (resource != null && resource.data.isPublic == true)
                  || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin()));
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Products collection (Monetization packages catalog)
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin(); // Super Admin can configure catalog
    }

    // Orders collection:
    // Super Admin has full visibility and write access for PayPal administration & order reconciliation
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSuperAdmin() || (
        isAuthenticated() 
        && request.resource.data.userId == request.auth.uid 
        && request.resource.data.status in ['pending', 'payment_pending', 'draft']
      );
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Payments collection:
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // Entitlements collection:
    // Super Admin can view, grant, revoke, and manage entitlements for any user or plan
    match /entitlements/{entitlementId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSuperAdmin() || (
        isAuthenticated() 
        && request.resource.data.userId == request.auth.uid 
        && (
          request.resource.data.packageId == 'free' ||
          (request.resource.data.packageId in ['pro', 'investor'] && request.resource.data.verificationToken != null)
        )
      );
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Subscriptions collection (Future recurring tiers)
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // Referrals collection
    match /referrals/{referralCode} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // Analytics telemetry
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // System configuration & settings
    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
