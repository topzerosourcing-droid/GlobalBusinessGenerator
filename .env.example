# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ----------------------------------------------------
# PayPal Production Integration Configuration (Live)
# ----------------------------------------------------
# Runtime environment: strictly 'live' for production
PAYPAL_MODE="live"

# LIVE PayPal REST API credentials (from developer.paypal.com Live Apps & Credentials)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Public client-side PayPal LIVE client ID (optional, mirrors PAYPAL_CLIENT_ID; secret remains server-side)
VITE_PAYPAL_CLIENT_ID=""

# LIVE PayPal Merchant Account Email
PAYPAL_MERCHANT_EMAIL="topogabolekwe@gmail.com"

# LIVE PayPal Webhook ID for signature verification
PAYPAL_WEBHOOK_ID=""

# Application server-side HMAC cryptographic secret (not a PayPal credential)
PAYMENT_SIGNING_SECRET=""
